# ==================================
# PAUL Open Model — Environment Variables
# ==================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Hugging Face ---
# Required to download gated models (Gemma 4 requires accepting license)
# Get your token: https://huggingface.co/settings/tokens
HF_TOKEN=

# Default namespace for pushing models/datasets to HF Hub
# Can be your username or an organization name
# Example: "your-username" or "paul-foundry"
HF_NAMESPACE=

# --- Kaggle ---
# Preferred Antigravity access uses OAuth through the workspace Kaggle MCP server
# configured in .agents/mcp_config.json.
# Optional fallback for classic Kaggle API/CLI requests. Generate from Kaggle Settings.
# Tokens currently begin with KGAT_. Keep this value only in your local .env.
KAGGLE_API_TOKEN=

# --- Weights & Biases (Optional) ---
# Set to "true" to enable W&B logging (disabled by default)
WANDB_ENABLED=false
WANDB_API_KEY=
WANDB_PROJECT=paul-open-model
WANDB_ENTITY=

# --- Training ---
# Override default output directory for checkpoints
# OUTPUT_DIR=./results

# Override default cache directory for downloaded models/datasets
# HF_HOME=~/.cache/huggingface

# --- Colab / Cloud ---
# Set to "true" when running in Google Colab
# COLAB_MODE=false
