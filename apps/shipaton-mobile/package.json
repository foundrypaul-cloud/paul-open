{
  "name": "@paul-open/shipaton-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "android:patch": "node scripts/patch-android.mjs",
    "android:prepare": "npm run build && npx cap sync android && npm run android:patch",
    "android:open": "npx cap open android",
    "assets:android": "npx @capacitor/assets generate --android --iconBackgroundColor '#101a2f' --iconBackgroundColorDark '#101a2f' --splashBackgroundColor '#09101f' --splashBackgroundColorDark '#09101f'"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@revenuecat/purchases-capacitor": "13.6.0",
    "@revenuecat/purchases-capacitor-ui": "13.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "@capacitor/assets": "3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
